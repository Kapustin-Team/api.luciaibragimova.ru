HOST=0.0.0.0
PORT=1337
NODE_ENV=production

# Strapi secrets — generate with: openssl rand -base64 32
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=***
ADMIN_JWT_SECRET=***
TRANSFER_TOKEN_SALT=***
JWT_SECRET=***

# PostgreSQL
DATABASE_CLIENT=postgres
DATABASE_HOST=<coolify-postgres-container-name>
DATABASE_PORT=5432
DATABASE_NAME=strapi_lucia
DATABASE_USERNAME=strapi_lucia
DATABASE_PASSWORD=***
DATABASE_SSL=false

# S3 / Selectel CDN
S3_ACCESS_KEY_ID=***
S3_ACCESS_SECRET=***
S3_ENDPOINT=https://s3.ru-7.storage.selcloud.ru
S3_REGION=ru-7
S3_BUCKET=kapustin-cdn
CDN_URL=https://cdn.kpstn.ru
